{
  "expo": {
    "name": "Oilix Filtration",
    "slug": "oilix-filtration",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "oilix-filtration",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#166534"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#166534"
      },
      "package": "dz.oilix.filtration",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.249/api/v1"
    }
  }
}
