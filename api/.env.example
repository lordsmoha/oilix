# PostgreSQL — LAN server uses localhost for DB
# Replace PASSWORD with your real PostgreSQL password
DATABASE_URL="postgresql://oilix:CHANGE_ME@localhost:5432/oilix?schema=public"

# Generate with: openssl rand -hex 32  (≥32 chars required in production)
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="8h"
PORT=3001
HOST=0.0.0.0
PUBLIC_HOST=192.168.1.249

# Include Nginx origin (no port) AND direct :3000
CORS_ORIGIN="http://192.168.1.249,http://192.168.1.249:3000,http://192.168.1.249:8081,exp://192.168.1.249:8081,http://localhost:3000,http://localhost:8081,exp://localhost:8081"

NODE_ENV=production
ENABLE_SWAGGER=true
