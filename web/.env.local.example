# CORRECT for Nginx (preferred — same origin, no CORS):
NEXT_PUBLIC_API_URL=/api/v1

# ALSO OK (absolute with http://):
# NEXT_PUBLIC_API_URL=http://192.168.1.249/api/v1

# WRONG (missing http://) — will break login unless code normalizes:
# NEXT_PUBLIC_API_URL=192.168.1.249/api/v1

# Optional: force Socket.IO origin (defaults try API :3001 then page origin)
# NEXT_PUBLIC_REALTIME_URL=http://192.168.1.249:3001

NEXT_PUBLIC_APP_URL=http://192.168.1.249
PUBLIC_HOST=192.168.1.249

# Next rewrite target when browsing :3000 without Nginx (server-side only)
# API_PROXY_TARGET=http://127.0.0.1:3001
