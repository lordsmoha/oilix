{
  "name": "oilix-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android",
    "build:apk": "cd android && gradlew.bat assembleRelease",
    "build:apk:unix": "cd android && ./gradlew assembleRelease",
    "build:apk:debug": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.7.9",
    "expo": "~52.0.23",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "^0.13.3",
    "expo-constants": "~17.0.4",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-print": "~14.0.3",
    "expo-router": "~4.0.15",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^1.25.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5",
    "socket.io-client": "^4.8.3",
